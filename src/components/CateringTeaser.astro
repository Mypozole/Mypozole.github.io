---
import cateringData from '../data/catering-pricing.json';
const d = cateringData.dropOff;
---
<section class="band" id="catering">
  <div class="wrap">
    <div class="sec-head">
      <p class="label">Catering</p>
      <h2>Feed the whole room.</h2>
      <p>Drop-off starts at ${d.minimumDollars} (${d.pricePerQuart}/quart, {d.minimumQuarts}-quart minimum). Pick the door that matches your event.</p>
    </div>
    <div class="doors">
      <a href="/catering/home" class="door">
        <h3>Home Catering</h3>
        <p>Family dinners and home gatherings, drop-off.</p>
      </a>
      <a href="/catering/office" class="door">
        <h3>Office Catering</h3>
        <p>Office lunches and recurring team orders, drop-off.</p>
      </a>
      <a href="/catering/events" class="door">
        <h3>Events Catering</h3>
        <p>Weddings, fundraisers, and on-site vending, full stand service.</p>
      </a>
    </div>
  </div>
</section>

<style>
  .doors { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-2); }
  @media (max-width: 820px) { .doors { grid-template-columns: 1fr; } }
  .door {
    display: block; border: 1.5px solid var(--line); border-radius: 4px; padding: var(--space-3);
    background: var(--paper); text-decoration: none; transition: border-color 0.15s;
  }
  .door:hover { border-color: var(--terracotta); }
  .door h3 { margin-bottom: 8px; }
  .door p { font-size: 14.5px; opacity: 0.72; }
</style>
