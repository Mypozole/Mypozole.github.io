---
import BaseLayout from '../layouts/BaseLayout.astro';
import cateringData from '../data/catering-pricing.json';
import site from '../data/site.json';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  otherDoors: { label: string; href: string }[];
  showPartyPackages?: boolean;
}

const { eyebrow, title, intro, otherDoors, showPartyPackages = false } = Astro.props;
const d = cateringData.dropOff;
const party = cateringData.pozolePartyPackages;
---
<BaseLayout title={`${title} | MyPozole Catering`} description={intro}>
  <div class="wrap">
    <header class="page-head">
      <p class="label">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="intro">{intro}</p>
    </header>

    <div class="door lead">
      <span class="flag">Drop off</span>
      <p class="price">${d.pricePerQuart} per quart &middot; {d.minimumQuarts} quart minimum (${d.minimumDollars} floor)</p>
      <p>We deliver hot pozole with all the toppings packed separate. You serve it.</p>
      <ul>
        <li>Pork, chicken, or vegan, mix as you like</li>
        {d.leadTimes.map((lt) => <li>{lt.range}, {lt.notice} notice</li>)}
        <li>Toppings and salsas included</li>
      </ul>
      <a class="btn" href={`mailto:${site.email}?subject=Catering drop-off inquiry`}>Ask about your order</a>
    </div>

    {showPartyPackages && (
      <div class="door">
        <span class="flag pending">Not bookable yet</span>
        <h3>Pozole Party, Packages A, B, C</h3>
        <p class="price">Per person, on-site service</p>
        <p>The full setup with a tostada bar and self-serve toppings.</p>
        <ul>
          <li>{party.serviceWindow}</li>
          <li>Add {party.addOns.join(', ')}</li>
          <li>{party.deposit}, {party.cancellationWindow} cancellation window</li>
        </ul>
        <p class="status">{party.status}</p>
        <p class="status-note">{party.minimumPeople}</p>
      </div>
    )}

    <nav class="cross-links">
      {otherDoors.map((door) => <a href={door.href}>{door.label}</a>)}
    </nav>
  </div>
</BaseLayout>

<style>
  .page-head { padding: var(--space-6) 0 var(--space-3); }
  .intro { font-size: 17px; opacity: 0.78; max-width: 62ch; line-height: 1.6; }

  .door {
    border: 1.5px solid var(--line); border-radius: 4px; padding: var(--space-4);
    background: var(--paper); margin-bottom: var(--space-3);
  }
  .door.lead { border-color: var(--terracotta); border-width: 2px; }
  .flag {
    display: inline-block; background: var(--terracotta); color: #fff;
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 5px 11px; border-radius: 2px; margin-bottom: var(--space-2);
  }
  .flag.pending { background: var(--tan); color: var(--brown); }
  .door h3 { margin-bottom: 7px; }
  .price { font-size: 15px; font-weight: 600; color: var(--rust); margin-bottom: var(--space-2); }
  .door > p:not(.price):not(.status):not(.status-note) { font-size: 15.5px; opacity: 0.76; margin-bottom: var(--space-2); }
  .door ul { list-style: none; font-size: 14.5px; margin-bottom: var(--space-3); }
  .door li { padding: 8px 0; border-bottom: 1px solid var(--line-soft); opacity: 0.78; }
  .door li:last-child { border-bottom: 0; }
  .door li::before { content: "+"; color: var(--terracotta); font-weight: 700; margin-right: 10px; }
  .status { font-size: 13.5px; color: var(--rust); font-weight: 600; margin-bottom: 4px; }
  .status-note { font-size: 12.5px; opacity: 0.6; }

  .cross-links { display: flex; gap: var(--space-3); padding: var(--space-3) 0 var(--space-6); flex-wrap: wrap; }
  .cross-links a { font-size: 14px; font-weight: 600; color: var(--terracotta); text-decoration: none; }
  .cross-links a:hover { text-decoration: underline; }
</style>
