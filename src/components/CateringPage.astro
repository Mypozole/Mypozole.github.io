---
import BaseLayout from '../layouts/BaseLayout.astro';
import CateringQuoteBuilder from './CateringQuoteBuilder.astro';
import cateringData from '../data/catering-pricing.json';
import site from '../data/site.json';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  otherDoors: { label: string; href: string }[];
  showDropOff?: boolean;
  showPartyPackages?: boolean;
}

const { eyebrow, title, intro, otherDoors, showDropOff = true, showPartyPackages = false } = Astro.props;
const party = cateringData.pozolePartyPackages;
const partyMailHref = `mailto:${site.email}?subject=${encodeURIComponent('Pozole Party inquiry')}`;
---
<BaseLayout title={`${title} | MyPozole Catering`} description={intro}>
  <div class="wrap">
    <header class="page-head">
      <p class="label">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="intro">{intro}</p>
    </header>

    {showDropOff && (
      <div class="builder-section">
        <p class="label">Build your order</p>
        <h2>Get a price in 20 seconds.</h2>
        <p class="builder-lead">Pick your quarts, see your total, send it to us. We confirm within hours. Nothing is charged now.</p>
        <CateringQuoteBuilder />
      </div>
    )}

    {showPartyPackages && (
      <div class="party">
        <div class="party-head">
          <p class="label">Pozole Party packages</p>
          <h2>Real pricing, on-site service.</h2>
          <p class="party-lead">A tostada bar and self-serve toppings, right at your event. Pick a tier, or tell us your headcount and we'll help you land on the right one.</p>
        </div>

        <div class="pkg-grid">
          {party.packages.map((pkg) => (
            <div class:list={['pkg', { 'pkg-featured': pkg.featured }]}>
              {pkg.featured && <span class="pkg-flag">Most popular</span>}
              <h3>{pkg.name}</h3>
              <p class="pkg-tag">{pkg.tagline}</p>
              <div class="pkg-price">
                <span class="pkg-amount">${pkg.pricePerPerson}</span>
                <span class="pkg-unit">/ person</span>
              </div>
              <p class="pkg-min">{pkg.minimumPeople} person minimum</p>
              <ul class="pkg-includes">
                {pkg.includes.map((item) => <li>{item}</li>)}
              </ul>
              <details class="pkg-addons">
                <summary>Add-ons</summary>
                <ul>
                  {pkg.addOns.map((a) => (
                    <li><span>{a.label}</span><span class="addon-price">{a.price}</span></li>
                  ))}
                </ul>
              </details>
            </div>
          ))}
        </div>

        <div class="party-terms">
          <h4>Every package includes</h4>
          <ul>
            {party.sharedTerms.map((t) => <li>{t}</li>)}
          </ul>
        </div>

        <div class="party-cta">
          <a class="btn" href={partyMailHref}>Request a Pozole Party</a>
          <p class="party-note">{party.status}</p>
        </div>
      </div>
    )}

    <nav class="cross-links">
      {otherDoors.map((door) => <a href={door.href}>{door.label}</a>)}
      <a href="/about-pozole">Not sure what pozole is? →</a>
    </nav>
  </div>
</BaseLayout>

<style>
  .page-head { padding: var(--space-6) 0 var(--space-3); }
  .intro { font-size: 17px; opacity: 0.78; max-width: 62ch; line-height: 1.6; }

  .builder-section { text-align: center; padding-bottom: var(--space-4); }
  .builder-section .label { justify-content: center; display: flex; }
  .builder-section h2 { margin-bottom: 10px; }
  .builder-lead { font-size: 16px; opacity: 0.72; max-width: 46ch; margin: 0 auto var(--space-3); }

  .party { padding-bottom: var(--space-4); }
  .party-head { text-align: center; margin-bottom: var(--space-4); }
  .party-head .label { justify-content: center; display: flex; }
  .party-head h2 { margin-bottom: 10px; }
  .party-lead { font-size: 16px; opacity: 0.72; max-width: 52ch; margin: 0 auto; }

  .pkg-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3);
    margin-bottom: var(--space-4); align-items: stretch;
  }
  @media (max-width: 860px) { .pkg-grid { grid-template-columns: 1fr; } }

  .pkg {
    position: relative; border: 1.5px solid var(--line); border-radius: 6px;
    padding: var(--space-4) var(--space-3); background: var(--paper);
    display: flex; flex-direction: column;
  }
  .pkg-featured { border-color: var(--terracotta); border-width: 2px; box-shadow: 0 4px 20px rgba(81, 26, 11, 0.07); }
  .pkg-flag {
    position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
    background: var(--terracotta); color: #fff; font-size: 10.5px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; padding: 5px 12px; border-radius: 20px;
    white-space: nowrap;
  }
  .pkg h3 { font-family: var(--serif); font-size: 21px; font-weight: 900; margin-bottom: 2px; }
  .pkg-tag { font-size: 13px; opacity: 0.62; margin-bottom: var(--space-2); }
  .pkg-price { display: flex; align-items: baseline; gap: 4px; margin-bottom: 4px; }
  .pkg-amount { font-family: var(--serif); font-size: 34px; font-weight: 900; color: var(--rust); }
  .pkg-unit { font-size: 13px; opacity: 0.6; }
  .pkg-min { font-size: 12.5px; font-weight: 700; color: var(--terracotta); margin-bottom: var(--space-3); }

  .pkg-includes { list-style: none; font-size: 14px; margin-bottom: var(--space-2); flex-grow: 1; }
  .pkg-includes li { padding: 7px 0; border-bottom: 1px solid var(--line-soft); opacity: 0.82; line-height: 1.4; }
  .pkg-includes li:last-child { border-bottom: 0; }
  .pkg-includes li::before { content: "+"; color: var(--terracotta); font-weight: 700; margin-right: 9px; }

  .pkg-addons { font-size: 13px; margin-top: auto; }
  .pkg-addons summary { cursor: pointer; font-weight: 700; color: var(--brown); padding: 8px 0; list-style: none; }
  .pkg-addons summary::-webkit-details-marker { display: none; }
  .pkg-addons summary::after { content: " ▾"; opacity: 0.5; }
  .pkg-addons[open] summary::after { content: " ▴"; }
  .pkg-addons ul { list-style: none; padding-top: 4px; }
  .pkg-addons li { display: flex; justify-content: space-between; gap: 10px; padding: 5px 0; opacity: 0.75; }
  .pkg-addons .addon-price { font-weight: 700; color: var(--rust); white-space: nowrap; }

  .party-terms {
    border-top: 1px solid var(--line-soft); padding-top: var(--space-3); margin-bottom: var(--space-4);
  }
  .party-terms h4 { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-2); opacity: 0.7; }
  .party-terms ul { list-style: none; font-size: 14px; columns: 2; column-gap: var(--space-4); }
  @media (max-width: 640px) { .party-terms ul { columns: 1; } }
  .party-terms li { padding: 6px 0; opacity: 0.72; line-height: 1.4; break-inside: avoid; }
  .party-terms li::before { content: "—"; color: var(--terracotta); margin-right: 8px; }

  .party-cta { text-align: center; }
  .party-note { font-size: 13px; opacity: 0.6; margin-top: var(--space-2); }

  .cross-links { display: flex; gap: var(--space-3); padding: var(--space-3) 0 var(--space-6); flex-wrap: wrap; }
  .cross-links a { font-size: 14px; font-weight: 600; color: var(--terracotta); text-decoration: none; }
  .cross-links a:hover { text-decoration: underline; }
</style>
