---
import site from '../data/site.json';
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="foot-logo">
          <img src="/logo.png" alt="" width="40" height="40" />
          <b>My<span>Pozole</span></b>
        </div>
        <p class="tagline">{site.tagline}</p>
        <div class="social">
          <a href={site.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href={site.social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
          <a href={site.social.twitter} target="_blank" rel="noopener noreferrer">Twitter</a>
        </div>
      </div>
      <div>
        <h4>Find us</h4>
        <a href="/#find">This week's schedule</a>
        <a href="/where-to-buy">Grocery stores</a>
      </div>
      <div>
        <h4>Order</h4>
        <a href="/catering/home">Catering</a>
        <a href="/menu">Menu</a>
      </div>
      <div>
        <h4>Business</h4>
        <a href="/wholesale">Wholesale</a>
        <a href="/about-pozole">Our story</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={`tel:${site.phone}`}>{site.phone}</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>&copy; {year} MyPozole, San Diego, California</span>
      <span class="office-note">{site.officeWarehouse.address}</span>
    </div>
  </div>
</footer>

<style>
  footer { background: var(--brown); color: var(--sand); padding: var(--space-6) 0 var(--space-3); font-size: 14.5px; }
  .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-4); }
  @media (max-width: 760px) { .foot-grid { grid-template-columns: 1fr 1fr; } }
  footer h4 { font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--tan); margin-bottom: var(--space-1); font-family: var(--sans); font-weight: 700; }
  footer a { color: var(--sand); text-decoration: none; opacity: 0.78; display: block; padding: 5px 0; }
  footer a:hover { opacity: 1; color: var(--terracotta); }
  .foot-logo { display: flex; align-items: center; gap: 10px; margin-bottom: var(--space-1); }
  .foot-logo img { border-radius: 50%; }
  .foot-logo b { font-family: var(--serif); font-size: 21px; font-weight: 900; color: #fff; }
  .tagline { opacity: 0.72; max-width: 32ch; margin-bottom: var(--space-2); }
  .social { display: flex; gap: var(--space-2); }
  .social a { padding: 0; }
  .foot-bottom {
    border-top: 1px solid rgba(214, 200, 175, 0.2); padding-top: var(--space-2);
    font-size: 12.5px; opacity: 0.6; display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-1);
  }
</style>
