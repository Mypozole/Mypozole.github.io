---
// Reusable badge icon for the three Catering doors on the homepage.
// SVG markup and colors sourced directly from catering-icons-mockup-v3.html.
interface Props {
  icon: 'house' | 'briefcase' | 'tent';
}
const { icon } = Astro.props;
---
<div class="catering-badge" aria-hidden="true">
  {icon === 'house' && (
    <svg viewBox="0 0 200 200" class="badge-icon" focusable="false">
      <ellipse cx="100" cy="172" rx="80" ry="8" fill="#C46838" opacity="0.15"/>
      <polygon points="45,100 100,55 155,100" fill="#8B3C1D" stroke="#511A0B" stroke-width="6" stroke-linejoin="round"/>
      <rect x="122" y="62" width="16" height="30" fill="#511A0B"/>
      <path d="M130,58 C124,48 136,42 130,32 C124,22 136,16 130,8" stroke="#8a7a68" stroke-width="5" fill="none" stroke-linecap="round" opacity="0.5"/>
      <rect x="58" y="100" width="84" height="66" fill="#CD9F71" stroke="#511A0B" stroke-width="6"/>
      <rect x="88" y="128" width="24" height="38" rx="2" fill="#511A0B"/>
      <circle cx="105" cy="147" r="2.4" fill="#CD9F71"/>
      <rect x="66" y="112" width="20" height="20" fill="#C46838" stroke="#511A0B" stroke-width="4"/>
      <line x1="76" y1="112" x2="76" y2="132" stroke="#511A0B" stroke-width="3"/>
      <line x1="66" y1="122" x2="86" y2="122" stroke="#511A0B" stroke-width="3"/>
      <rect x="114" y="112" width="20" height="20" fill="#C46838" stroke="#511A0B" stroke-width="4"/>
      <line x1="124" y1="112" x2="124" y2="132" stroke="#511A0B" stroke-width="3"/>
      <line x1="114" y1="122" x2="134" y2="122" stroke="#511A0B" stroke-width="3"/>
    </svg>
  )}
  {icon === 'briefcase' && (
    <svg viewBox="0 0 200 200" class="badge-icon" focusable="false">
      <ellipse cx="100" cy="172" rx="80" ry="8" fill="#C46838" opacity="0.15"/>
      <path d="M82,72 L82,58 C82,50 88,44 100,44 C112,44 118,50 118,58 L118,72" stroke="#511A0B" stroke-width="7" fill="none" stroke-linecap="round"/>
      <rect x="52" y="72" width="96" height="80" rx="8" fill="#C46838" stroke="#511A0B" stroke-width="6"/>
      <path d="M52,90 L52,80 C52,75 56,72 61,72 L139,72 C144,72 148,75 148,80 L148,90 Z" fill="#8B3C1D" stroke="#511A0B" stroke-width="6" stroke-linejoin="round"/>
      <rect x="90" y="100" width="20" height="14" rx="3" fill="#CD9F71" stroke="#511A0B" stroke-width="4"/>
      <rect x="52" y="130" width="96" height="10" fill="#8B3C1D" opacity="0.55"/>
      <path d="M92,68 C90,60 96,58 94,50" stroke="#8a7a68" stroke-width="4" fill="none" stroke-linecap="round" opacity="0.45"/>
      <path d="M108,68 C106,60 112,58 110,50" stroke="#8a7a68" stroke-width="4" fill="none" stroke-linecap="round" opacity="0.45"/>
    </svg>
  )}
  {icon === 'tent' && (
    <svg viewBox="0 0 200 200" class="badge-icon" focusable="false">
      <ellipse cx="100" cy="172" rx="80" ry="8" fill="#C46838" opacity="0.15"/>
      <path d="M38,80 L100,42 L162,80 L146,80 L100,54 L54,80 Z" fill="#CD9F71" stroke="#511A0B" stroke-width="6" stroke-linejoin="round"/>
      <line x1="100" y1="42" x2="100" y2="54" stroke="#511A0B" stroke-width="4"/>
      <rect x="54" y="80" width="92" height="18" fill="#8B3C1D" stroke="#511A0B" stroke-width="5"/>
      <rect x="70" y="85" width="60" height="8" rx="2" fill="#D6C8AF" opacity="0.85"/>
      <rect x="48" y="98" width="104" height="46" fill="#ffffff" stroke="#511A0B" stroke-width="6"/>
      <rect x="48" y="122" width="104" height="22" fill="#C46838" stroke="#511A0B" stroke-width="6"/>
      <rect x="42" y="80" width="7" height="66" fill="#511A0B"/>
      <rect x="151" y="80" width="7" height="66" fill="#511A0B"/>
    </svg>
  )}
  <div class="bowl-badge">
    <svg viewBox="0 0 40 40" focusable="false">
      <path d="M12,20 C10,15 15,13 12,8" stroke="#511A0B" stroke-width="2.6" fill="none" stroke-linecap="round" opacity="0.55"/>
      <path d="M20,20 C18,15 23,13 20,8" stroke="#511A0B" stroke-width="2.6" fill="none" stroke-linecap="round" opacity="0.55"/>
      <path d="M28,20 C26,15 31,13 28,8" stroke="#511A0B" stroke-width="2.6" fill="none" stroke-linecap="round" opacity="0.55"/>
      <path d="M8,24 C8,24 8,33 20,33 C32,33 32,24 32,24 Z" fill="#C46838" stroke="#511A0B" stroke-width="2.6"/>
      <ellipse cx="20" cy="24" rx="12" ry="4" fill="#CD9F71" stroke="#511A0B" stroke-width="2.6"/>
    </svg>
  </div>
</div>

<style>
  .catering-badge {
    width: 100%;
    max-width: 190px;
    aspect-ratio: 1;
    margin: 0 auto var(--space-2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 8px 22px rgba(81, 26, 11, 0.16);
    overflow: hidden;
    background: radial-gradient(circle at 35% 30%, #E4D7BF, #D6C8AF 70%);
  }
  .badge-icon { width: 88%; height: 88%; }

  .bowl-badge {
    position: absolute;
    bottom: 2%;
    right: 2%;
    width: 32%;
    height: 32%;
    border-radius: 50%;
    background: #fff;
    border: 4px solid #511A0B;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bowl-badge svg { width: 62%; height: 62%; }

  @media (max-width: 480px) {
    .catering-badge { max-width: 140px; }
  }
</style>
