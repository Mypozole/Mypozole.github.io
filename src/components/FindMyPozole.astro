---
const apiKey = import.meta.env.PUBLIC_GOOGLE_CALENDAR_API_KEY;
const farmersMarketsId = import.meta.env.PUBLIC_CALENDAR_ID_FARMERS_MARKETS;
const popupEventsId = import.meta.env.PUBLIC_CALENDAR_ID_POPUP_EVENTS;
const foodTruckId = import.meta.env.PUBLIC_CALENDAR_ID_FOOD_TRUCK;
---
<aside class="rail" id="find">
  <div class="sched" id="sched">
    <div class="sched-head">
      <span class="dot" id="sched-dot" aria-hidden="true"></span>
      <h2>Find MyPozole</h2>
    </div>
    <div class="sched-body" id="sched-body" data-key={apiKey} data-cal-farmers={farmersMarketsId} data-cal-popup={popupEventsId} data-cal-foodtruck={foodTruckId}>
      <p class="loading">Loading this week's stops...</p>
    </div>
  </div>
</aside>

<script>
  interface CalEvent {
    summary: string;
    location?: string;
    start: string;
    end: string;
  }

  function fmtTime(iso: string): string {
    return new Date(iso).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
  }
  function fmtDay(iso: string): string {
    return new Date(iso).toLocaleDateString('en-US', { weekday: 'short' });
  }

  async function fetchCalendar(calendarId: string, apiKey: string): Promise<CalEvent[]> {
    const timeMin = new Date().toISOString();
    const url = `https://www.googleapis.com/calendar/v3/calendars/${encodeURIComponent(calendarId)}/events?key=${apiKey}&singleEvents=true&orderBy=startTime&timeMin=${timeMin}&maxResults=8`;
    const res = await fetch(url);
    if (!res.ok) throw new Error(`Calendar fetch failed: ${res.status}`);
    const data = await res.json();
    return (data.items ?? [])
      .filter((e: any) => e.start?.dateTime && e.end?.dateTime)
      .map((e: any) => ({ summary: e.summary, location: e.location, start: e.start.dateTime, end: e.end.dateTime }));
  }

  async function initFindMyPozole() {
    const body = document.getElementById('sched-body');
    const dot = document.getElementById('sched-dot');
    if (!body) return;

    const apiKey = body.dataset.key;
    const farmersId = body.dataset.calFarmers;
    const popupId = body.dataset.calPopup;
    const foodTruckId = body.dataset.calFoodtruck;

    if (!apiKey || !farmersId || !popupId || !foodTruckId) {
      body.innerHTML = '<p class="pending">Calendar not configured yet.</p>';
      return;
    }

    try {
      const [farmers, popup, foodTruck] = await Promise.all([
        fetchCalendar(farmersId, apiKey),
        fetchCalendar(popupId, apiKey),
        fetchCalendar(foodTruckId, apiKey),
      ]);
      const events = [...farmers, ...popup, ...foodTruck].sort((a, b) => new Date(a.start).getTime() - new Date(b.start).getTime());

      const now = new Date();
      const live = events.find((e) => new Date(e.start) <= now && now <= new Date(e.end));
      const upcoming = events.filter((e) => new Date(e.start) > now).slice(0, 4);

      if (!live && upcoming.length === 0) {
        body.innerHTML = '<p class="pending">No upcoming stops on the calendar right now.</p>';
        return;
      }

      function mapsUrl(location?: string): string | null {
        return location ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location)}` : null;
      }
      function placeLink(name: string, location?: string): string {
        const url = mapsUrl(location);
        return url ? `<a href="${url}" target="_blank" rel="noopener noreferrer">${name}</a>` : name;
      }

      let html = '';
      if (live) {
        dot?.classList.add('is-live');
        html += `<div class="sched-now">
          <p class="lbl">Live now</p>
          <p class="place">${placeLink(live.summary, live.location)}</p>
          <p class="when">Until ${fmtTime(live.end)}${live.location ? `<br>${live.location}` : ''}</p>
        </div>`;
      } else if (upcoming[0]) {
        const next = upcoming[0];
        html += `<div class="sched-now">
          <p class="lbl">Next up</p>
          <p class="place">${placeLink(next.summary, next.location)}</p>
          <p class="when">${fmtDay(next.start)}, ${fmtTime(next.start)} to ${fmtTime(next.end)}${next.location ? `<br>${next.location}` : ''}</p>
        </div>`;
      }

      const rest = live ? upcoming.slice(0, 4) : upcoming.slice(1);
      for (const e of rest) {
        html += `<div class="stop">
          <span class="stop-day">${fmtDay(e.start)}</span>
          <div>
            <div class="stop-place">${placeLink(e.summary, e.location)}</div>
            <div class="stop-when">${fmtTime(e.start)} to ${fmtTime(e.end)}</div>
          </div>
        </div>`;
      }

      body.innerHTML = html;
    } catch (err) {
      body.innerHTML = '<p class="pending">Could not load the schedule right now.</p>';
      console.error('Find MyPozole calendar fetch failed', err);
    }
  }

  initFindMyPozole();
  document.addEventListener('astro:page-load', initFindMyPozole);
</script>

<style>
  .rail { position: sticky; top: 96px; }
  @media (max-width: 1040px) { .rail { position: static; margin-bottom: var(--space-4); } }

  .sched { border: 1.5px solid var(--brown); border-radius: 4px; overflow: hidden; background: var(--paper); }
  .sched-head { background: var(--brown); color: #fff; padding: 15px 18px; display: flex; align-items: center; gap: 9px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--tan); flex-shrink: 0; }
  .dot.is-live {
    background: #7BC47F; box-shadow: 0 0 0 0 rgba(123, 196, 127, 0.75); animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(123, 196, 127, 0.6); }
    70% { box-shadow: 0 0 0 9px rgba(123, 196, 127, 0); }
    100% { box-shadow: 0 0 0 0 rgba(123, 196, 127, 0); }
  }
  @media (prefers-reduced-motion: reduce) { .dot.is-live { animation: none; } }
  .sched-head h2 { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; color: #fff; }

  .sched-body { min-height: 60px; }
  .sched-body :global(.loading), .sched-body :global(.pending) { padding: 18px; font-size: 14px; opacity: 0.6; }

  .sched-body :global(.sched-now) { padding: 18px; background: var(--paper-warm); border-bottom: 1px solid var(--line); }
  .sched-body :global(.sched-now .lbl) { font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--rust); margin-bottom: 7px; }
  .sched-body :global(.sched-now .place) { font-family: var(--serif); font-size: 24px; font-weight: 900; line-height: 1.05; margin-bottom: 5px; }
  .sched-body :global(.sched-now .place a), .sched-body :global(.stop-place a) { color: inherit; text-decoration: none; }
  .sched-body :global(.sched-now .place a:hover), .sched-body :global(.stop-place a:hover) { text-decoration: underline; color: var(--terracotta); }
  .sched-body :global(.sched-now .when) { font-size: 13.5px; opacity: 0.72; }

  .sched-body :global(.stop) { padding: 14px 18px; border-bottom: 1px solid var(--line-soft); display: flex; gap: 14px; align-items: baseline; }
  .sched-body :global(.stop:last-child) { border-bottom: 0; }
  .sched-body :global(.stop-day) { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--terracotta); width: 40px; flex-shrink: 0; }
  .sched-body :global(.stop-place) { font-weight: 600; font-size: 15px; line-height: 1.25; }
  .sched-body :global(.stop-when) { font-size: 12.5px; opacity: 0.62; margin-top: 2px; }
</style>
