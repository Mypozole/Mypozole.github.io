---
import onlineOrdering from '../data/online-ordering.json';
import site from '../data/site.json';

const styleLabel: Record<string, string> = { white: 'White', red: 'Red', green: 'Green' };
const proteinLabel: Record<string, string> = { pork: 'Pork', chicken: 'Chicken', vegan: 'Vegan' };
const unitPrice = 15.99; // confirmed retail pouch price, see src/content/products/*.json
---
<form
  class="builder"
  id="rp-builder"
  novalidate
  data-min={onlineOrdering.minimumDollars}
  data-delivery-fee={onlineOrdering.deliveryFeeDollars}
  data-unit-price={unitPrice}
  data-email={site.email}
  data-formspree="https://formspree.io/f/xlgyqkpq"
  data-payments-endpoint="https://mypozole-payments-mypozole.vercel.app/api/create-payment-link"
>
  <div class="frozen-notice">
    <strong>The sealed grocery-store pouch, not the made-to-order quart.</strong> 32oz, two servings, no toppings included, the same pouch you'd find in the freezer aisle.
  </div>

  <div class="row">
    <div class="field">
      <label for="rp-protein">Protein</label>
      <select id="rp-protein">
        {Object.entries(proteinLabel).map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="rp-style">Style</label>
      <select id="rp-style">
        {Object.entries(styleLabel).map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>
    <div class="field qty">
      <label for="rp-qty">Qty</label>
      <input type="number" id="rp-qty" min="1" step="1" value="1" />
    </div>
    <button type="button" id="rp-add" class="btn add-btn">Add</button>
  </div>

  <ul id="rp-cart" class="cart"></ul>
  <p class="empty" id="rp-empty">Nothing added yet.</p>

  <div class="fulfillment">
    <label><input type="radio" name="rp-fulfillment" value="pickup" checked /> Pickup</label>
    <label><input type="radio" name="rp-fulfillment" value="delivery" /> Delivery (+${onlineOrdering.deliveryFeeDollars})</label>
  </div>

  <div class="total">
    <span>Estimated total</span>
    <b id="rp-total">$0</b>
  </div>
  <p class="min-warning" id="rp-min-warning"></p>
  <p class="fine">
    ${unitPrice} per pouch, the same price as in stores. ${onlineOrdering.minimumDollars} order minimum applies.
    You'll pay this total now on Square's secure checkout. Toppings are not included, add your own at home.
  </p>

  <div class="details">
    <div class="field-stack">
      <label for="rp-name">First name</label>
      <input class="inp" id="rp-name" type="text" autocomplete="given-name" />
      <div class="err">Add your first name.</div>
    </div>
    <div class="field-stack">
      <label for="rp-contact">Email or phone</label>
      <input class="inp" id="rp-contact" type="text" autocomplete="email" placeholder="jane@email.com or (619) 555-0123" />
      <div class="err">Add an email or a 10-digit phone number.</div>
    </div>
    <div class="field-stack" id="rp-address-field">
      <label for="rp-address">Delivery address</label>
      <input class="inp" id="rp-address" type="text" autocomplete="street-address" />
      <div class="err">We need a delivery address.</div>
    </div>
  </div>

  <button type="submit" class="btn submit" id="rp-submit">Continue to secure checkout →</button>
  <p class="rp-status" id="rp-status"></p>
</form>

<div class="builder confirm" id="rp-confirm">
  <div class="check">&#10003;</div>
  <h3>You're all set.</h3>
  <p class="reach" id="rp-reach"></p>
</div>

<script>
  interface CartLine { protein: string; style: string; qty: number; }

  function initRetailPouchBuilder() {
    const form = document.getElementById('rp-builder') as HTMLFormElement | null;
    const confirmEl = document.getElementById('rp-confirm');
    if (!form || !confirmEl) return;

    const minDollars = Number(form.dataset.min);
    const deliveryFee = Number(form.dataset.deliveryFee);
    const unitPrice = Number(form.dataset.unitPrice);
    const email = form.dataset.email as string;
    const formspree = form.dataset.formspree as string;
    const paymentsEndpoint = form.dataset.paymentsEndpoint as string;

    if (new URLSearchParams(window.location.search).get('paid') === 'pouch') {
      form.style.display = 'none';
      confirmEl.style.display = 'flex';
      const reachEl = document.getElementById('rp-reach');
      if (reachEl) reachEl.innerHTML = "Payment received, your order is in. We'll confirm pickup or delivery timing by email or phone.";
    }

    const proteinSelect = document.getElementById('rp-protein') as HTMLSelectElement;
    const styleSelect = document.getElementById('rp-style') as HTMLSelectElement;
    const qtyInput = document.getElementById('rp-qty') as HTMLInputElement;
    const addBtn = document.getElementById('rp-add') as HTMLButtonElement;
    const cartEl = document.getElementById('rp-cart') as HTMLUListElement;
    const emptyEl = document.getElementById('rp-empty') as HTMLElement;
    const totalEl = document.getElementById('rp-total') as HTMLElement;
    const warningEl = document.getElementById('rp-min-warning') as HTMLElement;
    const submitBtn = document.getElementById('rp-submit') as HTMLButtonElement;
    const statusEl = document.getElementById('rp-status') as HTMLElement;
    const nameInput = document.getElementById('rp-name') as HTMLInputElement;
    const contactInput = document.getElementById('rp-contact') as HTMLInputElement;
    const addressInput = document.getElementById('rp-address') as HTMLInputElement;
    const addressField = document.getElementById('rp-address-field') as HTMLElement;
    const fulfillmentRadios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="rp-fulfillment"]'));

    const labels: Record<string, string> = { pork: 'Pork', chicken: 'Chicken', vegan: 'Vegan', white: 'White', red: 'Red', green: 'Green' };

    let cart: CartLine[] = [];

    function fulfillment(): string {
      return fulfillmentRadios.find((r) => r.checked)?.value ?? 'pickup';
    }
    function validEmail(s: string) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s); }
    function validPhone(s: string) { return s.replace(/\D/g, '').length >= 10; }

    function computeTotal() {
      const items = cart.reduce((sum, l) => sum + l.qty, 0);
      const subtotal = cart.reduce((sum, l) => sum + l.qty * unitPrice, 0);
      const isDelivery = fulfillment() === 'delivery';
      const total = subtotal + (isDelivery && items > 0 ? deliveryFee : 0);
      return { items, subtotal, isDelivery, total };
    }

    function render() {
      cartEl.innerHTML = '';
      emptyEl.style.display = cart.length === 0 ? 'block' : 'none';

      cart.forEach((line, i) => {
        const li = document.createElement('li');
        li.className = 'cart-line';
        li.innerHTML = `<span>${line.qty} &times; ${labels[line.protein]} ${labels[line.style]}</span>`;
        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'remove';
        removeBtn.textContent = 'Remove';
        removeBtn.addEventListener('click', () => { cart.splice(i, 1); render(); });
        li.appendChild(removeBtn);
        cartEl.appendChild(li);
      });

      const { items, subtotal, isDelivery, total } = computeTotal();
      totalEl.textContent = `$${total.toFixed(2)}`;
      warningEl.textContent = items > 0 && subtotal < minDollars
        ? `$${minDollars} order minimum, add $${(minDollars - subtotal).toFixed(2)} more.`
        : '';
      addressField.style.display = isDelivery ? 'block' : 'none';
    }

    addBtn.addEventListener('click', () => {
      const qty = Math.max(1, Math.floor(Number(qtyInput.value) || 1));
      cart.push({ protein: proteinSelect.value, style: styleSelect.value, qty });
      qtyInput.value = '1';
      render();
    });
    fulfillmentRadios.forEach((r) => r.addEventListener('change', render));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const { items, subtotal, isDelivery, total } = computeTotal();
      const name = nameInput.value.trim();
      const contact = contactInput.value.trim();
      const address = addressInput.value.trim();
      const contactOk = validEmail(contact) || validPhone(contact);

      const errors: string[] = [];
      if (items === 0) errors.push('Add at least one item to your order.');
      if (subtotal < minDollars) errors.push(`$${minDollars} order minimum not met.`);
      if (!name) errors.push('name');
      if (!contactOk) errors.push('contact');
      if (isDelivery && !address) errors.push('address');
      nameInput.closest('.field-stack')?.classList.toggle('invalid', !name);
      contactInput.closest('.field-stack')?.classList.toggle('invalid', !contactOk);
      addressField.classList.toggle('invalid', isDelivery && !address);
      if (errors.length > 0) {
        statusEl.textContent = items === 0 ? 'Add at least one item first.' : 'Please fill in the highlighted fields.';
        return;
      }

      const lines = cart.map((l) => `${l.qty} x ${labels[l.protein]} ${labels[l.style]} pouch`).join('\n');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting order...';

      try {
        const res = await fetch(formspree, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            _subject: `Retail pouch order from ${name}`,
            Items: lines,
            Fulfillment: isDelivery ? 'Delivery' : 'Pickup',
            'Delivery address': isDelivery ? address : 'N/A (pickup)',
            Total: `$${total.toFixed(2)}`,
            'First name': name,
            Contact: contact,
          }),
        });
        if (!res.ok) throw new Error('Formspree responded ' + res.status);

        submitBtn.textContent = 'Taking you to secure checkout...';
        try {
          const payRes = await fetch(paymentsEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: `MyPozole Retail Pouch Order, ${lines.replace(/\n/g, ', ')}`,
              amountCents: Math.round(total * 100),
              redirectPath: `${window.location.pathname}?paid=pouch`,
            }),
          });
          const payData = await payRes.json();
          if (!payRes.ok || !payData.url) throw new Error(payData.error || 'No payment URL returned');
          window.location.href = payData.url;
        } catch (payErr) {
          console.error('Payment link creation failed', payErr);
          document.getElementById('rp-reach')!.innerHTML = `We have your order but had trouble starting checkout. We'll follow up at <strong>${contact}</strong> to take payment.`;
          form.style.display = 'none';
          confirmEl.style.display = 'flex';
        }
      } catch (err) {
        console.error('Retail pouch order submission failed', err);
        statusEl.textContent = `Something went wrong. Please email your order to ${email}.`;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Continue to secure checkout →';
      }
    });

    render();
  }

  initRetailPouchBuilder();
  document.addEventListener('astro:page-load', initRetailPouchBuilder);
</script>

<style>
  .builder {
    border: 1.5px solid var(--terracotta); border-radius: 4px; padding: var(--space-3);
    background: var(--paper); display: grid; gap: var(--space-2); margin-bottom: var(--space-3);
  }
  .frozen-notice {
    display: flex; align-items: baseline; gap: 6px; font-size: 13px; line-height: 1.5;
    background: var(--paper-warm); border: 1px solid var(--tan); border-radius: 3px;
    padding: 10px 12px; color: var(--brown);
  }
  .frozen-notice::before { content: "❄️"; flex-shrink: 0; }
  .frozen-notice strong { color: var(--rust); }
  .row { display: grid; grid-template-columns: 1fr 1fr 80px auto; gap: var(--space-1); align-items: end; }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr 1fr; } .row .add-btn { grid-column: 1 / -1; } }
  .field label { display: block; font-size: 12px; font-weight: 600; margin-bottom: 5px; }
  .field select, .field input {
    width: 100%; font-family: var(--sans); font-size: 14.5px; padding: 9px 10px;
    border: 1.5px solid var(--line); border-radius: 3px; background: var(--paper); color: var(--brown);
  }
  .add-btn { padding: 10px 18px; white-space: nowrap; }

  .cart { list-style: none; display: grid; gap: 6px; }
  .cart-line {
    display: flex; justify-content: space-between; align-items: center;
    background: var(--paper-warm); padding: 8px 12px; border-radius: 3px; font-size: 14px;
  }
  .cart-line .remove { background: none; border: 0; color: var(--rust); font-size: 12px; font-weight: 600; cursor: pointer; text-decoration: underline; }
  .empty { font-size: 13px; opacity: 0.5; font-style: italic; }

  .fulfillment { display: flex; gap: var(--space-3); font-size: 14px; }
  .fulfillment label { display: flex; align-items: center; gap: 6px; cursor: pointer; }

  .total {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: var(--space-2); background: var(--paper-warm); border-radius: 3px;
  }
  .total span { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.7; }
  .total b { font-family: var(--serif); font-size: 28px; color: var(--rust); font-variant-numeric: tabular-nums; }
  .min-warning { font-size: 12.5px; color: var(--rust); font-weight: 600; min-height: 1em; }
  .fine { font-size: 12px; opacity: 0.55; }

  .details { display: grid; gap: 10px; padding-top: var(--space-1); border-top: 1px dashed var(--line); }
  .field-stack label { display: block; font-size: 12px; font-weight: 600; margin-bottom: 4px; }
  .field-stack .inp {
    width: 100%; font-family: var(--sans); font-size: 14.5px; padding: 9px 10px;
    border: 1.5px solid var(--line); border-radius: 3px; background: var(--paper); color: var(--brown);
  }
  .field-stack .err { color: var(--rust); font-size: 11.5px; margin-top: 3px; display: none; }
  .field-stack.invalid .inp { border-color: var(--rust); }
  .field-stack.invalid .err { display: block; }
  #rp-address-field { display: none; }

  .submit { width: 100%; }
  .submit:disabled { opacity: 0.6; cursor: not-allowed; }
  .rp-status { font-size: 12.5px; color: var(--rust); text-align: center; min-height: 1.2em; }

  .confirm { display: none; flex-direction: column; text-align: center; }
  .confirm .check { width: 52px; height: 52px; border-radius: 50%; background: var(--terracotta); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 26px; margin: 0 auto 12px; }
  .confirm h3 { font-family: var(--serif); font-size: 19px; font-weight: 900; margin-bottom: 10px; }
  .confirm .reach { font-size: 14px; opacity: 0.8; }
</style>
