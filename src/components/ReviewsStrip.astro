---
import { getEntry } from 'astro:content';
const porkWhite = await getEntry('products', 'pork-white');
const n = porkWhite!.data.nutrition;
---
<section class="band" id="reviews">
  <div class="wrap">
    <div class="sec-head">
      <p class="label">What people say</p>
      <h2>Don't take our word for it.</h2>
    </div>
    <div class="reviews-slot">
      <p><b>Live reviews go here.</b></p>
      <p>Real customer reviews, pulled live from Google and Yelp so they stay current on their own. Nothing on this strip is written by us.</p>
    </div>

    <div class="stats">
      <div class="stat"><b>{n.proteinGrams}g</b><span>Protein, Pork White</span></div>
      <div class="stat"><b>{n.calories}</b><span>Calories per serving</span></div>
      <div class="stat"><b>{n.fiberGrams}g</b><span>Fiber per serving</span></div>
    </div>
    <p class="fine">Per {n.servingSize} serving. Figures vary by protein and style, see the full nutrition panel on each product.</p>
  </div>
</section>

<style>
  .reviews-slot {
    border: 2px dashed var(--tan); border-radius: 4px; padding: var(--space-6) var(--space-3);
    text-align: center; background: var(--paper); margin-bottom: var(--space-2);
  }
  .reviews-slot p { font-size: 15px; opacity: 0.7; max-width: 56ch; margin: 0 auto; }
  .reviews-slot p + p { margin-top: 10px; }
  .reviews-slot b { color: var(--rust); opacity: 1; }

  .stats {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    background: var(--line); border: 1px solid var(--line); border-radius: 4px; overflow: hidden;
  }
  .stat { background: var(--paper); padding: var(--space-3) var(--space-2); text-align: center; }
  .stat b { display: block; font-family: var(--serif); font-weight: 900; font-size: 38px; line-height: 1; color: var(--rust); font-variant-numeric: tabular-nums; }
  .stat span { font-size: 12px; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; opacity: 0.62; display: block; margin-top: 9px; }
  .fine { font-size: 12.5px; opacity: 0.55; margin-top: var(--space-2); text-align: center; }
</style>
