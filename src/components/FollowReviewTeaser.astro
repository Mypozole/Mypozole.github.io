---
import site from '../data/site.json';
import qr from '../data/qr-page.json';
---
<section class="band" id="follow-review">
  <div class="wrap">
    <div class="sec-head">
      <p class="label">Follow &amp; review</p>
      <h2>Loved your bowl? Tell people.</h2>
    </div>
    <div class="cols">
      <div class="col">
        <p class="col-label">Follow along</p>
        <div class="link-row">
          <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="pill pill-primary">Instagram</a>
          {site.social.facebook && <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" class="pill">Facebook</a>}
          {site.social.twitter && <a href={site.social.twitter} target="_blank" rel="noopener noreferrer" class="pill">Twitter</a>}
        </div>
      </div>
      <div class="col">
        <p class="col-label">Leave a review</p>
        <div class="link-row">
          <a href={qr.reviews.google} target="_blank" rel="noopener noreferrer" class="pill">Google review</a>
          <a href={qr.reviews.yelp} target="_blank" rel="noopener noreferrer" class="pill">Yelp review</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  @media (max-width: 640px) { .cols { grid-template-columns: 1fr; gap: var(--space-3); } }
  .col-label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--terracotta); margin-bottom: var(--space-2);
  }
  .link-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .pill {
    display: inline-block; padding: 10px 18px; border-radius: 20px; font-size: 13.5px; font-weight: 700;
    text-decoration: none; border: 1.5px solid var(--brown); color: var(--brown); background: var(--paper);
    transition: background 0.15s;
  }
  .pill:hover { background: var(--paper-warm); }
  .pill-primary { background: var(--brown); color: #fff; }
  .pill-primary:hover { background: var(--rust); border-color: var(--rust); }
</style>
