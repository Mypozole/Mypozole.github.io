---
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuTeaser from '../components/MenuTeaser.astro';
import OnlineOrderBuilder from '../components/OnlineOrderBuilder.astro';
import onlineOrdering from '../data/online-ordering.json';
---
<BaseLayout title="Menu | MyPozole" description="Five ways to eat MyPozole, at the market, the trailer, or delivered.">
  <div class="wrap">
    <header class="page-head">
      <p class="label">Menu</p>
      <h1>Five ways to eat it.</h1>
      <p class="intro">
        Pozole itself can be delivered or picked up, ${onlineOrdering.minimumDollars} minimum,
        ${onlineOrdering.deliveryFeeDollars} delivery fee. {onlineOrdering.fulfillsOnly}{' '}
        Everything else on this page is market and trailer only, since the
        commissary can't fulfill it.
      </p>
    </header>
    <div class="order-section" id="order">
      <p class="label">Order Pozole online</p>
      <OnlineOrderBuilder />
    </div>
  </div>
  <MenuTeaser />
</BaseLayout>

<style>
  .page-head { padding: var(--space-6) 0 var(--space-3); }
  .page-head h1 { margin-bottom: var(--space-2); }
  .intro { font-size: 17px; opacity: 0.78; max-width: 62ch; line-height: 1.6; }
  .order-section { max-width: 480px; margin-top: var(--space-3); }
  .order-section .label { margin-bottom: var(--space-2); }
</style>
