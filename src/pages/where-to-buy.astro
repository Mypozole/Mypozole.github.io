---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import photoPorkRed from '../assets/photos/takehome_pork_red.jpg';
import photoChickenGreen from '../assets/photos/takehome_chicken_green.jpg';

const locations = await getCollection('locations');
---
<BaseLayout title="Where to Buy | MyPozole" description="Every store carrying MyPozole. Click a store to see what's in stock there.">
  <div class="wrap">
    <header class="page-head">
      <p class="label">Where to buy</p>
      <h1>Take home a pouch.</h1>
      <p class="intro">
        Frozen 32oz pouches, $15.99, ready to heat on the stove. Click a
        store to see exactly what's stocked there before you drive over.
      </p>
    </header>

    <div class="pouches">
      <div class="pouch-photo">
        <Image src={photoPorkRed} alt="MyPozole Red Style Pork Pozole pouch, 32oz" width={500} height={667} />
        <p>Red Style Pork, 24g protein</p>
      </div>
      <div class="pouch-photo">
        <Image src={photoChickenGreen} alt="MyPozole Green Style Chicken Pozole pouch, 32oz" width={500} height={667} />
        <p>Green Style Chicken, 25g protein</p>
      </div>
      <div class="pouch-note">
        <p><b>What to look for in the freezer aisle.</b></p>
        <p>Two servings per pouch. Toppings (cabbage, radishes, onions, jalapeños, cilantro, oregano, red pepper flakes, limes, avocado) are not included, add your own at home.</p>
      </div>
    </div>

    <div class="stores">
      {locations.map((loc) => (
        <a href={`/where-to-buy/${loc.id}`} class="store" data-store-name={loc.data.name}>
          <h3>{loc.data.name}</h3>
          <p class="city">{loc.data.city}</p>
          <p class="next-demo" data-demo-slot></p>
          <span class="see-stock">See what's in stock →</span>
        </a>
      ))}
    </div>

    <script define:vars={{ apiKey: import.meta.env.PUBLIC_GOOGLE_CALENDAR_API_KEY, calendarId: import.meta.env.PUBLIC_CALENDAR_ID_IN_STORE_DEMOS }}>
      async function loadNextDemos() {
        if (!apiKey || !calendarId) return;
        try {
          const timeMin = new Date().toISOString();
          const url = `https://www.googleapis.com/calendar/v3/calendars/${encodeURIComponent(calendarId)}/events?key=${apiKey}&singleEvents=true&orderBy=startTime&timeMin=${timeMin}&maxResults=20`;
          const res = await fetch(url);
          if (!res.ok) return;
          const data = await res.json();
          const events = (data.items ?? []).filter((e) => e.start?.dateTime);

          document.querySelectorAll('.store').forEach((store) => {
            const name = store.getAttribute('data-store-name') ?? '';
            const firstWord = name.split(' ')[0].toLowerCase();
            const match = events.find((e) => `${e.summary ?? ''} ${e.location ?? ''}`.toLowerCase().includes(firstWord));
            const slot = store.querySelector('[data-demo-slot]');
            if (match && slot) {
              const date = new Date(match.start.dateTime).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
              slot.textContent = `Next demo: ${date}`;
            }
          });
        } catch (err) {
          console.error('In-store demo fetch failed', err);
        }
      }
      loadNextDemos();
    </script>

    <div class="ask">
      <div>
        <h3>Not stocked near you?</h3>
        <p>Tell us where you shop and we'll send a request card to hand your grocery manager.</p>
      </div>
      <a class="btn" href="/contact">Request a store</a>
    </div>
  </div>
</BaseLayout>

<style>
  .page-head { padding: var(--space-6) 0 var(--space-3); }
  .page-head h1 { margin-bottom: var(--space-2); }
  .intro { font-size: 17px; opacity: 0.78; max-width: 62ch; line-height: 1.6; }

  .pouches { display: grid; grid-template-columns: 1fr 1fr 1.3fr; gap: var(--space-2); margin-bottom: var(--space-4); }
  @media (max-width: 760px) { .pouches { grid-template-columns: 1fr 1fr; } .pouch-note { grid-column: 1 / -1; } }
  .pouch-photo { border: 1px solid var(--line); border-radius: 4px; overflow: hidden; background: var(--paper); }
  .pouch-photo :global(img) { width: 100%; aspect-ratio: 3/4; object-fit: cover; display: block; }
  .pouch-photo p { font-size: 12.5px; font-weight: 600; padding: 10px 12px; opacity: 0.75; }
  .pouch-note { border: 1px solid var(--line); border-radius: 4px; background: var(--paper-warm); padding: var(--space-3); display: flex; flex-direction: column; justify-content: center; }
  .pouch-note p:first-child { margin-bottom: 8px; }
  .pouch-note p { font-size: 13.5px; opacity: 0.75; line-height: 1.55; }

  .stores { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-2); margin: var(--space-4) 0; }
  @media (max-width: 940px) { .stores { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .stores { grid-template-columns: 1fr; } }
  .store {
    background: var(--paper); border: 1px solid var(--line); border-radius: 4px; padding: var(--space-3);
    text-decoration: none; display: block; transition: border-color 0.15s;
  }
  .store:hover { border-color: var(--terracotta); }
  .store h3 { margin-bottom: 2px; color: var(--brown); }
  .city { font-size: 13px; opacity: 0.6; margin-bottom: var(--space-1); }
  .next-demo { font-size: 12px; font-weight: 600; color: var(--rust); min-height: 1em; margin-bottom: var(--space-1); }
  .see-stock { display: block; font-size: 12.5px; font-weight: 600; color: var(--terracotta); margin-top: var(--space-1); }

  .ask {
    margin: var(--space-4) 0 var(--space-6); background: var(--brown); color: #fff; border-radius: 4px; padding: var(--space-4);
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); flex-wrap: wrap;
  }
  .ask h3 { color: #fff; margin-bottom: 6px; }
  .ask p { font-size: 15px; opacity: 0.82; max-width: 50ch; }
  .ask .btn { background: var(--terracotta); }
</style>
