---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FindMyPozole from '../../components/FindMyPozole.astro';
import WhereToBuyTeaser from '../../components/WhereToBuyTeaser.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import photoPozole from '../../assets/photos/pozole.jpg';
import photoBurrito from '../../assets/photos/burrito.jpg';
import photoPoznachos from '../../assets/photos/poznachos.jpg';
import photoPozfrito from '../../assets/photos/pozfrito.jpg';
import photoPoztada from '../../assets/photos/poztada.jpg';
import photoTakehomeQuart from '../../assets/photos/takehome-quart-hero.png';

export async function getStaticPaths() {
  const items = await getCollection('menuItems');
  return items.map((item) => ({ params: { item: item.id }, props: { item } } as const));
}

interface Props {
  item: Awaited<ReturnType<typeof getCollection<'menuItems'>>>[number];
}

const { item } = Astro.props;

const photos: Record<string, ImageMetadata> = {
  pozole: photoPozole,
  'pozole-burrito': photoBurrito,
  poznachos: photoPoznachos,
  pozfrito: photoPozfrito,
  poztada: photoPoztada,
  'takehome-pozole': photoTakehomeQuart,
};
const photo = photos[item.id];
const isPozole = item.id === 'pozole';
const hasDeliverable = item.data.variants.some((v) => v.fulfillment === 'delivery-or-pickup');
const hasMarketOnly = item.data.variants.some((v) => v.fulfillment === 'market-and-trailer-only');
---
<BaseLayout title={`${item.data.name} | MyPozole`} description={item.data.description}>
  <div class="wrap">
    <a href="/menu" class="back">← Full menu</a>
    <div class="layout">
      <div class="photo-col">
        {photo ? (
          <Image src={photo} alt={item.data.name} width={700} height={700} />
        ) : (
          <div class="photo-placeholder"><span>{item.data.name}</span></div>
        )}
      </div>
      <div class="info-col">
        <h1>{item.data.name}</h1>
        <p class="long-desc">{item.data.longDescription}</p>

        <div class="variants">
          {item.data.variants.map((v) => (
            <div class="variant">
              <div class="variant-head">
                <span class="variant-label">{v.label}</span>
                <span class="variant-price">${v.priceDollars.toFixed(2).replace(/\.00$/, '')}</span>
              </div>
              <p class="variant-note">{v.note}</p>
              <p class="variant-badge">{v.fulfillment === 'delivery-or-pickup' ? 'Delivery or pickup' : 'Market and trailer only'}</p>
            </div>
          ))}
        </div>

        {hasDeliverable && (
          <a href="/menu#order" class="btn">Order it online</a>
        )}
      </div>
    </div>

    {hasMarketOnly && (
      <section class="find-section">
        <h2>{isPozole ? 'Find it hot, or buy it frozen' : 'Find it at the market or trailer'}</h2>
        <div class="find-grid">
          <FindMyPozole />
        </div>
      </section>
    )}
  </div>

  {isPozole && <WhereToBuyTeaser />}
</BaseLayout>

<style>
  .back { display: inline-block; font-size: 13.5px; font-weight: 600; color: var(--terracotta); text-decoration: none; margin-top: var(--space-4); }
  .back:hover { text-decoration: underline; }

  .layout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); padding: var(--space-3) 0 var(--space-4); align-items: start; }
  @media (max-width: 820px) { .layout { grid-template-columns: 1fr; } }

  .photo-col :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; }
  .photo-placeholder {
    aspect-ratio: 1; border-radius: 4px; background: var(--sand-pale);
    display: flex; align-items: center; justify-content: center;
  }
  .photo-placeholder span { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--rust); opacity: 0.6; }

  .info-col h1 { margin-bottom: var(--space-2); }
  .long-desc { font-size: 17px; line-height: 1.65; opacity: 0.82; margin-bottom: var(--space-3); }

  .variants { display: grid; gap: var(--space-2); margin-bottom: var(--space-3); }
  .variant { border: 1px solid var(--line); border-radius: 4px; padding: var(--space-2) var(--space-3); background: var(--paper); }
  .variant-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-2); margin-bottom: 4px; }
  .variant-label { font-weight: 700; font-size: 15px; color: var(--brown); }
  .variant-price { font-family: var(--serif); font-size: 18px; font-weight: 900; color: var(--rust); }
  .variant-note { font-size: 13.5px; opacity: 0.7; line-height: 1.5; margin-bottom: 6px; }
  .variant-badge { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--terracotta); }

  .find-section { padding: var(--space-4) 0 var(--space-6); border-top: 1px solid var(--line-soft); }
  .find-section h2 { margin-bottom: var(--space-2); }
  .find-grid { max-width: 400px; }
</style>
