---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import qr from '../data/qr-page.json';
---
<BaseLayout title="MyPozole" description="Order, learn about pozole, leave a review, or join the list.">
  <div class="wrap">
    <header class="hero">
      <img src="/logo.png" alt="MyPozole" class="logo" width="88" height="88" />
      <p class="tagline">{site.longTagline}</p>
    </header>

    <div class="paths">
      <a href="/menu#order" class="path path-order">
        <span class="path-q">Want to order?</span>
        <span class="path-a">See the menu →</span>
      </a>
      <a href="/about-pozole" class="path path-learn">
        <span class="path-q">Want to learn about pozole?</span>
        <span class="path-a">Read the story →</span>
      </a>
    </div>

    <section class="block">
      <p class="block-label">Follow along</p>
      <div class="social-row">
        <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="social social-primary">Instagram</a>
        {site.social.facebook && <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" class="social">Facebook</a>}
        {site.social.twitter && <a href={site.social.twitter} target="_blank" rel="noopener noreferrer" class="social">Twitter</a>}
      </div>
    </section>

    <section class="block">
      <p class="block-label">Loved your bowl?</p>
      <div class="review-row">
        <a href={qr.reviews.google} target="_blank" rel="noopener noreferrer" class="review-btn">Leave a Google review</a>
        <a href={qr.reviews.yelp} target="_blank" rel="noopener noreferrer" class="review-btn">Leave a Yelp review</a>
      </div>
    </section>

    <section class="block signup-block">
      <p class="block-label">Join the list</p>
      <h2>{qr.mailingList.headline}</h2>
      <p class="signup-body">{qr.mailingList.body}</p>
      <form id="link-signup" novalidate data-formspree={qr.mailingList.formspree} data-email={site.email}>
        <div class="signup-row">
          <input class="inp" id="ls-email" type="email" placeholder="you@email.com" autocomplete="email" required />
          <button type="submit" class="btn" id="ls-submit">{qr.mailingList.buttonLabel}</button>
        </div>
        <p class="signup-status" id="ls-status"></p>
      </form>
    </section>

    <nav class="footer-links">
      <a href="/">See the full site →</a>
    </nav>
  </div>
</BaseLayout>

<script define:vars={{ email: site.email }}>
  function initLinkSignup() {
    const form = document.getElementById('link-signup');
    if (!form) return;
    const endpoint = form.dataset.formspree;
    const input = document.getElementById('ls-email');
    const submitBtn = document.getElementById('ls-submit');
    const status = document.getElementById('ls-status');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const value = input.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
        status.textContent = 'Add a valid email address.';
        return;
      }
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ _subject: 'Mailing list signup', Email: value }),
        });
        if (!res.ok) throw new Error('Formspree responded ' + res.status);
        status.textContent = "You're on the list. Watch your inbox for your code.";
        form.reset();
        submitBtn.textContent = 'Send my code';
        submitBtn.disabled = false;
      } catch (err) {
        console.error('Mailing list signup failed', err);
        status.textContent = `Something went wrong. Email us at ${email} and we'll add you directly.`;
        submitBtn.textContent = 'Send my code';
        submitBtn.disabled = false;
      }
    });
  }
  initLinkSignup();
  document.addEventListener('astro:page-load', initLinkSignup);
</script>

<style>
  .wrap { max-width: 480px; padding-top: var(--space-4); padding-bottom: var(--space-6); }

  .hero { text-align: center; padding-bottom: var(--space-4); }
  .logo { border-radius: 50%; margin-bottom: var(--space-2); }
  .tagline { font-family: var(--serif); font-size: 20px; font-weight: 700; opacity: 0.85; max-width: 32ch; margin: 0 auto; }

  .paths { display: grid; gap: var(--space-2); margin-bottom: var(--space-5); }
  .path {
    display: flex; flex-direction: column; gap: 4px; padding: var(--space-3);
    border-radius: 6px; text-decoration: none; color: #fff;
  }
  .path-order { background: var(--terracotta); }
  .path-learn { background: var(--brown); }
  .path-q { font-family: var(--serif); font-size: 20px; font-weight: 900; }
  .path-a { font-size: 13.5px; opacity: 0.85; font-weight: 600; }

  .block { text-align: center; padding: var(--space-3) 0; border-top: 1px solid var(--line-soft); }
  .block-label { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--terracotta); margin-bottom: var(--space-2); }

  .social-row, .review-row { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
  .social, .review-btn {
    display: inline-block; padding: 10px 18px; border-radius: 20px; font-size: 13.5px; font-weight: 700;
    text-decoration: none; border: 1.5px solid var(--brown); color: var(--brown);
  }
  .social-primary { background: var(--brown); color: #fff; }
  .review-btn { border-color: var(--tan); }
  .social:hover, .review-btn:hover { background: var(--paper-warm); }
  .social-primary:hover { background: var(--rust); border-color: var(--rust); }

  .signup-block h2 { font-family: var(--serif); font-size: 22px; font-weight: 900; margin-bottom: 6px; }
  .signup-body { font-size: 14px; opacity: 0.72; max-width: 38ch; margin: 0 auto var(--space-2); line-height: 1.55; }
  .signup-row { display: flex; gap: 8px; max-width: 380px; margin: 0 auto; }
  .signup-row .inp {
    flex: 1; padding: 11px 12px; font-size: 14.5px; font-family: var(--sans); color: var(--brown);
    background: #fff; border: 1.5px solid var(--line); border-radius: 3px; outline: none;
  }
  .signup-row .inp:focus { border-color: var(--terracotta); }
  .signup-row .btn { white-space: nowrap; }
  .signup-status { font-size: 12.5px; opacity: 0.7; margin-top: 10px; min-height: 1.2em; }

  .footer-links { text-align: center; padding-top: var(--space-4); }
  .footer-links a { font-size: 13px; font-weight: 600; color: var(--terracotta); text-decoration: none; }
  .footer-links a:hover { text-decoration: underline; }
</style>
