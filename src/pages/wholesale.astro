---
import BaseLayout from '../layouts/BaseLayout.astro';
import WholesaleTeaser from '../components/WholesaleTeaser.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const stats = await getCollection('wholesaleStats');
const retailerDemand = stats.find((s) => s.id === 'retailer-demand');
---
<BaseLayout title="Wholesale | MyPozole" description="Velocity data and sample requests for grocery buyers.">
  <div class="wrap">
    <header class="page-head">
      <p class="label">For grocery buyers</p>
      <h1>Already moving off six shelves.</h1>
      <p class="intro">
        We make pozole in San Diego and we can make a lot more of it.
        {retailerDemand && <> {retailerDemand.data.value.toLowerCase()}.</>}
      </p>
    </header>
  </div>

  <WholesaleTeaser />

  <div class="wrap">
    <div class="gaps">
      <h3>Case pack, margin, lead time, certifications, sell sheet</h3>
      <p>Not published yet, this section is waiting on real numbers before it goes live rather than an estimate.</p>
      <a class="btn outline" href={`mailto:${site.email}?subject=Wholesale inquiry`}>Request a sample and sell sheet</a>
    </div>
  </div>
</BaseLayout>

<style>
  .page-head { padding: var(--space-6) 0 var(--space-3); }
  .page-head h1 { margin-bottom: var(--space-2); }
  .intro { font-size: 17px; opacity: 0.78; max-width: 62ch; line-height: 1.6; }
  .gaps { padding: var(--space-4) 0 var(--space-6); border-top: 1px solid var(--line-soft); margin-top: var(--space-2); }
  .gaps h3 { margin-bottom: 8px; }
  .gaps p { font-size: 15px; opacity: 0.7; margin-bottom: var(--space-2); max-width: 56ch; }
</style>
