---
import BaseLayout from '../layouts/BaseLayout.astro';
import WholesaleTeaser from '../components/WholesaleTeaser.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const stats = await getCollection('wholesaleStats');
const retailerDemand = stats.find((s) => s.id === 'retailer-demand');
---
<BaseLayout title="Wholesale | MyPozole" description="Velocity data and sample requests for grocery buyers.">
  <div class="wrap">
    <header class="page-head">
      <p class="label">For grocery buyers</p>
      <h1>Already moving off six shelves.</h1>
      <p class="intro">
        We make pozole in San Diego and we can make a lot more of it.
        {retailerDemand && <> {retailerDemand.data.value.toLowerCase()}.</>}
      </p>
    </header>
  </div>

  <WholesaleTeaser />

  <div class="wrap">
    <div class="form-wrap">
      <h2>Interested in carrying MyPozole?</h2>
      <p class="form-lead">Tell us a bit about your store, we'll follow up with pricing, samples, and everything else you need.</p>
      <form id="wholesale-form" novalidate data-formspree="https://formspree.io/f/xlgyqkpq" data-email={site.email}>
        <div class="field">
          <label for="wf-store">Store or company name</label>
          <input class="inp" id="wf-store" type="text" required />
        </div>
        <div class="field">
          <label for="wf-name">Your name</label>
          <input class="inp" id="wf-name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="wf-contact">Email or phone</label>
          <input class="inp" id="wf-contact" type="text" autocomplete="email" placeholder="jane@store.com or (619) 555-0123" required />
        </div>
        <div class="field">
          <label for="wf-message">What are you looking for? <span class="opt">(optional)</span></label>
          <textarea class="inp" id="wf-message" rows="3"></textarea>
        </div>
        <button type="submit" class="btn" id="wf-submit">Request sample &amp; sell sheet</button>
        <p class="wf-status" id="wf-status"></p>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  function initWholesaleForm() {
    const form = document.getElementById('wholesale-form') as HTMLFormElement | null;
    if (!form) return;
    const endpoint = form.dataset.formspree as string;
    const email = form.dataset.email as string;
    const submitBtn = document.getElementById('wf-submit') as HTMLButtonElement;
    const status = document.getElementById('wf-status') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const store = (document.getElementById('wf-store') as HTMLInputElement).value.trim();
      const name = (document.getElementById('wf-name') as HTMLInputElement).value.trim();
      const contact = (document.getElementById('wf-contact') as HTMLInputElement).value.trim();
      const message = (document.getElementById('wf-message') as HTMLTextAreaElement).value.trim();
      if (!store || !name || !contact) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            _subject: `Wholesale sample request from ${store}`,
            Store: store, Name: name, Contact: contact, Message: message || 'None',
          }),
        });
        if (!res.ok) throw new Error('Formspree responded ' + res.status);
        status.textContent = "Sent. We'll follow up with a sample and sell sheet soon.";
        form.reset();
        submitBtn.textContent = 'Request sample & sell sheet';
        submitBtn.disabled = false;
      } catch (err) {
        console.error('Wholesale form submission failed', err);
        status.textContent = `Something went wrong. Please email us directly at ${email}.`;
        submitBtn.textContent = 'Request sample & sell sheet';
        submitBtn.disabled = false;
      }
    });
  }
  initWholesaleForm();
  document.addEventListener('astro:page-load', initWholesaleForm);
</script>

<style>
  .page-head { padding: var(--space-6) 0 var(--space-3); }
  .page-head h1 { margin-bottom: var(--space-2); }
  .intro { font-size: 17px; opacity: 0.78; max-width: 62ch; line-height: 1.6; }
  .form-wrap { max-width: 480px; padding-top: var(--space-4); padding-bottom: var(--space-6); border-top: 1px solid var(--line-soft); margin-top: var(--space-2); }
  .form-wrap h2 { margin-bottom: 8px; }
  .form-lead { font-size: 15px; opacity: 0.7; margin-bottom: var(--space-3); max-width: 56ch; }
  .field { margin-bottom: 14px; }
  .field label { display: block; font-size: 12.5px; font-weight: 700; margin-bottom: 5px; }
  .field .opt { font-weight: 500; opacity: 0.6; }
  .inp {
    width: 100%; padding: 12px 13px; font-size: 15px; font-family: var(--sans); color: var(--brown);
    background: #fff; border: 1.5px solid var(--line); border-radius: 3px; outline: none; transition: border-color 0.15s;
  }
  .inp:focus { border-color: var(--terracotta); }
  textarea.inp { resize: vertical; }
  .wf-status { font-size: 13px; opacity: 0.7; margin-top: var(--space-2); min-height: 1.2em; }
</style>
