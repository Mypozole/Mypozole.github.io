---
import CateringPage from '../../components/CateringPage.astro';
import eventsHero from '../../assets/photos/events-catering-hero.jpg';
---
<CateringPage
  eyebrow="Events Catering"
  title="Feed the whole room."
  intro="Weddings, large private parties, fundraisers, community events, and on-site corporate vending. Home and Office are both drop-off, Events is the full stand."
  heroPhoto={eventsHero}
  heroAlt="MyPozole food truck serving guests at an outdoor wedding reception."
  showDropOff={false}
  showPartyPackages={true}
  otherDoors={[
    { label: 'Smaller? See Home Catering →', href: '/catering/home' },
    { label: 'Office lunch instead? See Office Catering →', href: '/catering/office' },
  ]}
/>
